{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "loomground-governance",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "standard/language-card.json", "jsonpath": "$.version" },
